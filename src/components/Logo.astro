---
// Brand mark (inline SVG, same paths as the mockup's #ocan-mark) + wordmark. Link to `href` when given.
import { site } from '../data/site';

interface Props {
  sub?: string; // e.g. "Industrial Sourcing & Solutions"
  href?: string;
}

const { sub, href } = Astro.props;
const Tag = href ? 'a' : 'span';
const [subTop, subBottom] = sub ? sub.split(' & ') : [];
---
<Tag class="logo" href={href}>
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <path d="M11.97 10.53 A14 14 0 1 0 28.03 10.53" fill="none" stroke="#d7262e" stroke-width="5" stroke-linecap="round" />
    <line x1="20" y1="5" x2="20" y2="20" stroke="#d7262e" stroke-width="5" stroke-linecap="round" />
  </svg>
  <span class="logo-word">{site.name}</span>
  {sub && <span class="logo-sub">{subTop}{subBottom && <><br />&amp; {subBottom}</>}</span>}
</Tag>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .mark { width: 38px; height: 38px; flex: none; }
  .logo-word { font-family: var(--head); font-weight: 800; font-size: 34px; letter-spacing: .02em; color: var(--white); line-height: 1; }
  .logo-sub { display: block; font-family: var(--head); font-weight: 600; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted-light); line-height: 1.25; border-left: 1px solid var(--line-dark); padding-left: 10px; margin-left: 2px; }

  @media (max-width: 1080px) {
    .logo-sub { display: none; }
  }
  @media (max-width: 600px) {
    .logo-word { font-size: 28px; }
    .mark { width: 32px; height: 32px; }
  }
</style>
