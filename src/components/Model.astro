---
import Icon from './Icon.astro';
import { rich } from '../lib/rich';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict['model'];
  num?: string;
}

const { t, num } = Astro.props;
---
<section class="block paper" id="model" aria-labelledby="model-title">
  <div class="container">
    <div class="sec-head model-head">
      <div class="eyebrow">{num && <span class="num">{num}</span>}{t.eyebrow}</div>
      <h2 id="model-title" set:html={rich(t.title)} />
      <p set:html={rich(t.lead)} />
    </div>

    <ul class="core" role="list">
      {t.pillars.map((pillar) => (
        <li class="core-item">
          <div class="core-icon"><Icon name={pillar.icon} size={28} /></div>
          <h3>{pillar.title}</h3>
          <p set:html={rich(pillar.text)} />
        </li>
      ))}
    </ul>

    <h3 class="why-title" id="why-title">{t.whyTitle}</h3>
    <ul class="why" role="list" aria-labelledby="why-title">
      {t.why.map((item) => (
        <li class="why-item">
          <Icon name={item.icon} size={30} />
          <h4>{item.title}</h4>
          <p set:html={rich(item.text)} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Headline with a slanted red rule, like a pull quote */
  .sec-head.model-head { position: relative; max-width: 1000px; margin-bottom: 52px; padding-left: 34px; }
  .model-head::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 6px; width: 9px; background: var(--red); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), 0 100%); }
  .sec-head.model-head h2 { font-size: clamp(34px, 5vw, 62px); line-height: 1; }
  .sec-head.model-head p { max-width: 700px; margin-top: 22px; font-size: 19px; }

  /* Three core pillars: dark band with the diagonal cut */
  .core { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); background: var(--ink); color: var(--white); border-top: 4px solid var(--red); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 34px), calc(100% - 34px) 100%, 0 100%); }
  .core-item { padding: 42px 36px 58px; }
  .core-item + .core-item { border-left: 1px solid var(--line-dark); }
  .core-icon { width: 60px; height: 60px; display: grid; place-items: center; margin-bottom: 24px; background: var(--red); color: var(--white); clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
  .core-item h3 { font-size: 28px; font-weight: 700; color: var(--white); }
  .core-item h3::after { content: ""; display: block; width: 32px; height: 3px; background: var(--red); margin: 12px 0 14px; }
  .core-item p { max-width: 34ch; font-size: 16.5px; color: var(--muted-light); }

  /* Why our business model works: 4x2 cards */
  .why-title { display: flex; align-items: center; gap: 16px; margin: 80px 0 30px; font-size: clamp(28px, 3.2vw, 40px); font-weight: 800; color: var(--ink); }
  .why-title::before { content: ""; flex: none; width: 14px; height: 34px; background: var(--red); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
  .why { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .why-item { position: relative; overflow: hidden; padding: 28px 24px 30px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); transition: transform .25s, box-shadow .25s; }
  .why-item::before { content: ""; position: absolute; left: 0; top: 0; height: 4px; width: 0; background: var(--red); transition: width .35s ease; }
  .why-item:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .why-item:hover::before { width: 100%; }
  .why-item > :global(svg) { display: block; margin-bottom: 16px; color: var(--red); }
  .why-item h4 { margin-bottom: 8px; font-size: 21px; font-weight: 700; line-height: 1.1; color: var(--ink); }
  .why-item p { font-size: 15.5px; color: var(--muted); }

  @media (max-width: 1080px) {
    .why { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .core { grid-template-columns: 1fr; }
    .core-item { padding: 34px 28px 36px; }
    .core-item + .core-item { border-left: 0; border-top: 1px solid var(--line-dark); }
    .core-item:last-child { padding-bottom: 56px; }
  }
  @media (max-width: 600px) {
    .sec-head.model-head { padding-left: 22px; }
    .model-head::before { width: 6px; }
    .sec-head.model-head p { font-size: 17px; }
    .why { grid-template-columns: 1fr; }
    .why-title { margin-top: 56px; }
  }
</style>
