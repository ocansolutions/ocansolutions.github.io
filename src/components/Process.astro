---
import { Picture } from 'astro:assets';
import plantNight from '../assets/plant-night.jpg';
import Icon from './Icon.astro';
import { rich } from '../lib/rich';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict['process'];
  num?: string;
}

const { t, num } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// The trial loop sits under the step it belongs to. Connector stubs are placed by that step's column
// in the 4-column desktop grid (--col4) and in the 2-column tablet grid (--col2).
const trialIndex = t.trialStep - 1;
const trialStyle = `--col4:${trialIndex % 4};--col2:${trialIndex % 2}`;
---
<section class="block dark process" id="how-we-work" aria-labelledby="process-title">
  <div class="process-bg" aria-hidden="true">
    <Picture
      src={plantNight}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 768, 900]}
      sizes="100vw"
    />
  </div>

  <div class="container">
    <div class="sec-head reveal">
      <div class="eyebrow">{num && <span class="num">{num}</span>}{t.eyebrow}</div>
      <h2 id="process-title" set:html={rich(t.title)} />
      <p set:html={rich(t.lead)} />
    </div>

    <ol class="summary reveal" role="list">
      {t.summary.map((label, i) => (
        <li class:list={['phase', { 'is-last': i === t.summary.length - 1 }]} set:html={rich(label)} />
      ))}
    </ol>

    <ol class="steps reveal" role="list">
      {t.steps.map((step, i) => (
        <>
          <li class:list={['step', { 'end-4': i % 4 === 3, 'end-2': i % 2 === 1 }]}>
            <div class="step-line"><span class="step-num">{pad(i + 1)}</span></div>
            <h3><Icon name={step.icon} size={20} /><span set:html={rich(step.title)} /></h3>
            <p set:html={rich(step.text)} />
          </li>
          {i === trialIndex && (
            <li class="trial" style={trialStyle}>
              <span class="loop-link down" aria-hidden="true"></span>
              <span class="loop-link up" aria-hidden="true"></span>
              <div class="trial-box">
                <div class="trial-icon"><Icon name={t.trialLoop.icon} size={26} /></div>
                <div>
                  <h3><span class="trial-tag">{pad(t.trialStep)}</span>{t.trialLoop.title}</h3>
                  <p set:html={rich(t.trialLoop.text)} />
                </div>
              </div>
            </li>
          )}
        </>
      ))}
    </ol>

    <h3 class="benefits-title reveal" id="benefits-title">{t.benefitsTitle}</h3>
    <ul class="benefits reveal" role="list" aria-labelledby="benefits-title">
      {t.benefits.map((benefit) => (
        <li class="benefit">
          <Icon name={benefit.icon} size={26} />
          <div>
            <h4>{benefit.title}</h4>
            <p set:html={rich(benefit.text)} />
          </div>
        </li>
      ))}
    </ul>

    <p class="closing reveal" set:html={rich(t.closing)} />
  </div>
</section>

<style>
  .process { position: relative; overflow: hidden; }
  /* Faded photo behind the top of the section only, so it isn't stretched over the whole tall section */
  .process-bg { position: absolute; inset: 0 0 auto 0; height: 760px; opacity: .16; filter: grayscale(.4); -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent); mask-image: linear-gradient(180deg, #000 35%, transparent); pointer-events: none; }
  .process-bg :global(picture), .process-bg :global(img) { display: block; width: 100%; height: 100%; }
  .process-bg :global(img) { object-fit: cover; object-position: 50% 40%; }
  .process .container { position: relative; }

  /* ---------- Four-phase summary: chevrons pointing right ---------- */
  .summary { list-style: none; margin: 0 0 64px; padding: 0; display: flex; }
  .phase { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 66px; padding: 14px 34px; text-align: center; background: var(--steel); color: var(--white); font-family: var(--head); font-weight: 700; font-size: 17px; letter-spacing: .06em; line-height: 1.15; text-transform: uppercase; clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 50%, calc(100% - 20px) 100%, 0 100%, 20px 50%); }
  .phase:first-child { clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 50%, calc(100% - 20px) 100%, 0 100%); }
  .phase + .phase { margin-left: -16px; }
  .phase.is-last { background: var(--red); clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 20px 50%); }
  .phase :global(em) { font-style: normal; color: inherit; }

  /* ---------- Eight steps: 4x2 grid, dashed line between the number circles ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .step { position: relative; padding: 0 22px 44px 0; }
  .step-line { display: flex; align-items: center; margin-bottom: 22px; }
  .step-num { flex: none; width: 52px; height: 52px; display: grid; place-items: center; border-radius: 50%; background: var(--red); font-family: var(--head); font-weight: 800; font-size: 20px; box-shadow: 0 0 0 6px rgba(215, 38, 46, .18); }
  .step-line::after { content: ""; flex: 1; height: 2px; margin-left: 12px; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, .35) 0 8px, transparent 8px 14px); }
  .step.end-4 .step-line::after { display: none; }
  .step h3 { display: flex; align-items: center; gap: 10px; font-size: 21px; font-weight: 700; letter-spacing: .02em; }
  .step h3 > :global(svg) { color: var(--red); }
  .step p { max-width: 250px; margin-top: 8px; font-size: 15.5px; color: var(--muted-light); }

  /* ---------- Trial loop: a dashed box under step 6, joined to it by a down and an up arrow ---------- */
  .trial { position: relative; grid-column: 1 / -1; grid-row: 3; }
  .loop-link { position: absolute; top: -44px; width: 2px; height: 44px; background: repeating-linear-gradient(180deg, var(--red) 0 6px, transparent 6px 11px); }
  .loop-link::after { content: ""; position: absolute; left: -5px; width: 12px; height: 8px; background: var(--red); }
  .loop-link.down { left: calc(var(--col4) * 25% + 12px); }
  .loop-link.down::after { bottom: -1px; clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .loop-link.up { left: calc(var(--col4) * 25% + 36px); }
  .loop-link.up::after { top: -1px; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .trial-box { position: relative; display: flex; align-items: center; gap: 24px; padding: 26px 32px; background: rgba(215, 38, 46, .08); border: 2px dashed rgba(215, 38, 46, .8); border-radius: var(--radius); }
  .trial-icon { flex: none; width: 60px; height: 60px; display: grid; place-items: center; border-radius: 50%; background: var(--red); color: var(--white); }
  .trial-icon :global(svg) { animation: loop-spin 9s linear infinite; }
  @keyframes loop-spin { to { transform: rotate(360deg); } }
  .trial h3 { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 12px; font-size: 24px; font-weight: 700; }
  .trial-tag { display: inline-grid; place-items: center; padding: 3px 10px; background: var(--red); color: var(--white); font-size: 15px; font-weight: 800; letter-spacing: .04em; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
  .trial p { max-width: 74ch; margin-top: 8px; font-size: 16.5px; color: #c9ccd2; }

  /* ---------- Benefits ---------- */
  .benefits-title { display: flex; align-items: center; gap: 16px; margin: 40px 0 24px; font-size: clamp(26px, 3vw, 34px); font-weight: 800; }
  .benefits-title::before { content: ""; flex: none; width: 14px; height: 32px; background: var(--red); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); }
  .benefit { display: flex; align-items: center; gap: 14px; padding: 22px; background: rgba(18, 19, 21, .92); }
  .benefit > :global(svg) { color: var(--red); }
  .benefit h4 { font-size: 16.5px; font-weight: 700; letter-spacing: .05em; line-height: 1.15; }
  .benefit p { margin-top: 2px; font-size: 13.5px; line-height: 1.35; color: var(--muted-light); }

  /* ---------- Closing statement ---------- */
  .closing { position: relative; max-width: 960px; margin-top: 64px; padding: 4px 0 4px 40px; font-family: var(--head); font-weight: 700; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.1; text-transform: uppercase; }
  .closing::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 12px; background: var(--red); clip-path: polygon(0 0, 100% 0, 40% 100%, 0 100%); }
  .closing :global(em) { font-style: normal; color: var(--red); }

  @media (prefers-reduced-motion: reduce) {
    .trial-icon :global(svg) { animation: none; }
  }
  @media (max-width: 1080px) {
    .benefits { grid-template-columns: repeat(2, 1fr); }
  }
  /* Tablet: summary stacks (arrows point down), steps go 2 columns and the loop box follows step 6's row */
  @media (max-width: 900px) {
    .summary { flex-direction: column; gap: 6px; margin-bottom: 48px; }
    .phase, .phase:first-child, .phase.is-last { clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), 50% 100%, 0 calc(100% - 14px)); padding: 14px 24px 24px; min-height: 0; }
    .phase.is-last { clip-path: none; padding-bottom: 14px; }
    .phase + .phase { margin-left: 0; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .step.end-4 .step-line::after { display: block; }
    .step.end-2 .step-line::after { display: none; }
    .trial { grid-row: auto; }
    .loop-link.down { left: calc(var(--col2) * 50% + 12px); }
    .loop-link.up { left: calc(var(--col2) * 50% + 36px); }
    .trial-box { margin-bottom: 44px; }
  }
  /* Mobile: one vertical timeline; the loop box branches off the rail at step 6 */
  @media (max-width: 600px) {
    .steps { display: block; }
    .step, .trial { padding: 0 0 34px 74px; }
    .step::before, .trial::before { content: ""; position: absolute; left: 25px; top: 56px; bottom: 2px; width: 2px; background: repeating-linear-gradient(180deg, rgba(255, 255, 255, .35) 0 7px, transparent 7px 12px); }
    .trial::before { top: 0; }
    .step:last-child { padding-bottom: 0; }
    .step:last-child::before { display: none; }
    .step-line { position: absolute; left: 0; top: 0; margin: 0; }
    .step-line::after, .step.end-4 .step-line::after, .step.end-2 .step-line::after { display: none; }
    .step h3 { min-height: 52px; font-size: 20px; }
    .step p { max-width: none; }
    .loop-link { display: none; }
    .trial-box { flex-direction: column; align-items: flex-start; gap: 14px; margin-bottom: 0; padding: 22px 20px; }
    .trial-box::before { content: ""; position: absolute; left: -49px; top: 45px; width: 47px; border-top: 2px dashed rgba(215, 38, 46, .8); }
    .trial-icon { width: 48px; height: 48px; }
    .trial h3 { font-size: 21px; }
    .trial p { font-size: 15.5px; }
    .benefits { grid-template-columns: 1fr; }
    .closing { margin-top: 48px; padding-left: 28px; }
    .closing::before { width: 9px; }
  }
</style>
