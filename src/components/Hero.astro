---
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero-mine.jpg';
import Icon from './Icon.astro';
import { rich } from '../lib/rich';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict['hero'];
}

const { t } = Astro.props;
---
<section class="hero">
  <div class="hero-media">
    <Picture
      src={heroImage}
      alt={t.imageAlt}
      formats={['avif', 'webp']}
      widths={[480, 768, 940]}
      sizes="(max-width: 900px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-slash" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-copy">
      <div class="kicker">{t.kicker}</div>
      <h1>
        {t.titleLines.map((line) => <><Fragment set:html={rich(line)} /><br /></>)}
        <em set:html={rich(t.titleAccent)} />
      </h1>
      <p class="hero-lead" set:html={rich(t.lead)} />
      <div class="hero-ctas">
        <a href="#contact" class="btn btn-red">{t.ctaPrimary} <Icon name="arrow-right" size={18} /></a>
        <a href="#how-we-work" class="btn btn-ghost">{t.ctaSecondary}</a>
      </div>
      <div class="hero-sectors">
        {t.sectors.map((sector) => <div><Icon name={sector.icon} size={20} />{sector.label}</div>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { --focus: #ffb3b6; position: relative; background: var(--ink); color: var(--white); overflow: hidden; }
  .hero-media { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%); }
  .hero-media :global(picture), .hero-media :global(img) { display: block; width: 100%; height: 100%; }
  .hero-media :global(img) { object-fit: cover; object-position: 50% 60%; }
  .hero-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18, 19, 21, .55), rgba(18, 19, 21, 0) 45%), linear-gradient(0deg, rgba(18, 19, 21, .55), rgba(18, 19, 21, 0) 40%); }
  .hero-slash { position: absolute; top: 0; bottom: 0; left: calc(50% - 16px); width: 11%; background: var(--red); clip-path: polygon(calc(100% - 10px) 0, 100% 0, 10px 100%, 0 100%); }
  .hero .container { position: relative; z-index: 2; min-height: min(86vh, 720px); display: flex; flex-direction: column; justify-content: center; padding-top: 72px; padding-bottom: 140px; }
  .hero-copy { max-width: min(640px, 47vw); }
  .kicker { display: inline-flex; align-items: center; gap: 12px; font-family: var(--head); font-weight: 600; font-size: 15px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted-light); margin-bottom: 26px; }
  .kicker::before { content: ""; width: 36px; height: 3px; background: var(--red); }
  .hero h1 { font-size: clamp(42px, 5vw, 74px); font-weight: 800; letter-spacing: -.005em; }
  .hero h1 :global(em) { font-style: normal; color: var(--red); }
  .hero-lead { margin-top: 26px; font-size: 19px; color: #c9ccd2; max-width: 520px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .hero-sectors { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 46px; padding-top: 26px; border-top: 1px solid var(--line-dark); max-width: 560px; }
  .hero-sectors div { display: flex; align-items: center; gap: 9px; font-family: var(--head); font-weight: 600; font-size: 15px; letter-spacing: .1em; text-transform: uppercase; color: #dfe1e5; }
  .hero-sectors :global(svg) { color: var(--red); }

  @media (max-width: 900px) {
    .hero-copy { max-width: 640px; }
    .hero-media { width: 100%; clip-path: none; opacity: .38; }
    .hero-slash { display: none; }
    .hero .container { min-height: auto; padding-top: 64px; padding-bottom: 130px; }
  }
  @media (max-width: 600px) {
    .hero-lead { font-size: 17px; }
  }
</style>
