---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Model from '../components/Model.astro';
import Areas from '../components/Areas.astro';
import Solutions from '../components/Solutions.astro';
import Process from '../components/Process.astro';
import Industries from '../components/Industries.astro';
import Pilot from '../components/Pilot.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { en } from '../i18n/en';
---
<Base meta={en.meta}>
  <Header t={en.header} />
  <main id="main">
    <Hero t={en.hero} />
    <Stats t={en.stats} />
    <About t={en.about} num="01" />
    <Model t={en.model} num="02" />
    <Areas t={en.areas} num="03" />
    <Solutions t={en.solutions} num="04" />
    <Process t={en.process} num="05" />
    <Industries t={en.industries} num="06" />
    <Pilot t={en.pilot} num="07" />
    <Contact t={en.contact} num="08" />
  </main>
  <Footer t={en.footer} />
</Base>
