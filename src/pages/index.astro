---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Model from '../components/Model.astro';
import Areas from '../components/Areas.astro';
import Solutions from '../components/Solutions.astro';
import { en } from '../i18n/en';
---
<Base meta={en.meta}>
  <Header t={en.header} />
  <main id="main">
    <Hero t={en.hero} />
    <Stats t={en.stats} />
    <About t={en.about} num="01" />
    <Model t={en.model} num="02" />
    <Areas t={en.areas} num="03" />
    <Solutions t={en.solutions} num="04" />
    {/* How we work, industries, pilot and contact are added in phase 3 (numbers 05-08). */}
  </main>
</Base>
